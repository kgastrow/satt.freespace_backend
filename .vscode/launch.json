{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: FastAPI (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/app/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app/backend"
            }
        },
        {
            "name": "Backend: ARQ Worker",
            "type": "debugpy",
            "request": "launch",
            "module": "arq",
            "args": [
                "app.workers.worker.WorkerSettings"
            ],
            "justMyCode": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/app/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app/backend"
            }
        },
        {
            "name": "Backend: Current Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "justMyCode": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/app/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app/backend"
            }
        },
        {
            "name": "Backend: pytest (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v",
                "-s"
            ],
            "justMyCode": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/app/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app/backend"
            }
        },
        {
            "name": "Frontend: Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/app/frontend/src",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/*"
            },
            "preLaunchTask": "npm: dev - frontend"
        },
        {
            "name": "Frontend: Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/app/frontend/src",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/*"
            },
            "preLaunchTask": "npm: dev - frontend"
        },
        {
            "name": "Frontend: Attach to Chrome",
            "type": "chrome",
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}/app/frontend/src",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/*"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack: Backend + Frontend",
            "configurations": [
                "Backend: FastAPI (uvicorn)",
                "Frontend: Chrome"
            ],
            "stopAll": true
        }
    ]
}
