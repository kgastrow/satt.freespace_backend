{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "dev",
            "path": "app/frontend",
            "label": "npm: dev - frontend",
            "detail": "Start Vite dev server",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+): (error|warning) (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "ready in \\d+ ms"
                }
            }
        },
        {
            "type": "shell",
            "label": "Backend: Start uvicorn",
            "command": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}/app/backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "python",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Started reloader",
                    "endsPattern": "Application startup complete"
                }
            }
        },
        {
            "type": "shell",
            "label": "Backend: Start ARQ worker",
            "command": "arq",
            "args": ["app.workers.worker.WorkerSettings"],
            "options": {
                "cwd": "${workspaceFolder}/app/backend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "build",
            "path": "app/frontend",
            "label": "npm: build - frontend",
            "detail": "Build frontend for production",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "test:run",
            "path": "app/frontend",
            "label": "npm: test - frontend",
            "detail": "Run frontend tests",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Backend: Run tests",
            "command": "python",
            "args": ["-m", "pytest", "tests", "-v"],
            "options": {
                "cwd": "${workspaceFolder}/app/backend"
            },
            "problemMatcher": []
        }
    ]
}
