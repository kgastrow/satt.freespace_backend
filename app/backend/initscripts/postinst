#!/usr/bin/env bash
set -e

INSTALL_DIR="/home/ayzer_backend"

# Install uv if not present
if ! command -v uv &> /dev/null; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"
fi

# Use a shared location for uv-managed Python so www-data can access it
export UV_PYTHON_INSTALL_DIR=/opt/uv/python

# Create Python virtual environment if it doesn't exist or is broken
if [ ! -x "${INSTALL_DIR}/.venv/bin/python" ]; then
    echo "Creating virtual environment..."
    rm -rf ${INSTALL_DIR}/.venv
    uv venv --python 3.12 ${INSTALL_DIR}/.venv
    chmod -R a+rX /opt/uv
fi

# Install dependencies
VIRTUAL_ENV="${INSTALL_DIR}/.venv" uv pip install -r ${INSTALL_DIR}/requirements.txt

# Create config.json if it doesn't exist
if [ ! -f "${INSTALL_DIR}/config.json" ]; then
    cp ${INSTALL_DIR}/config.json.example ${INSTALL_DIR}/config.json
    echo "Please edit ${INSTALL_DIR}/config.json with your configuration"
fi

# Remove the example config
rm -f ${INSTALL_DIR}/config.json.example

# Set proper permissions
chown -R www-data:www-data ${INSTALL_DIR}

# Copy Apache config only if it doesn't exist
if [ ! -f /etc/apache2/sites-available/ayzer_backend.conf ]; then
    cp ${INSTALL_DIR}/apache_site_config/ayzer_backend.conf /etc/apache2/sites-available/
fi
rm -rf ${INSTALL_DIR}/apache_site_config

# Enable Apache modules
a2enmod proxy proxy_http proxy_wstunnel headers ssl rewrite

# Enable the site
a2ensite ayzer_backend

# Reload systemd and Apache
systemctl daemon-reload
systemctl reload apache2

# Enable and start services
echo "Adding AYZER Backend services..."
systemctl enable ayzer_backend.service
systemctl enable ayzer_worker.service

echo "Starting AYZER Backend applications..."
systemctl start ayzer_backend.service
systemctl start ayzer_worker.service

echo "AYZER Backend installed successfully!"
echo "Please edit ${INSTALL_DIR}/config.json and run database migrations"
