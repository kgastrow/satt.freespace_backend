[Unit]
Description=Ayzer ARQ Background Worker
After=syslog.target network.target redis.service ayzer_backend.service

[Service]
Type=simple
WorkingDirectory=/home/ayzer_backend/
ExecStart=/home/ayzer_backend/.venv/bin/arq src.workers.worker.WorkerSettings
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
