[Unit]
Description=Ayzer Backend Service
After=syslog.target network.target

[Service]
Type=simple
WorkingDirectory=/home/ayzer_backend/
ExecStart=/home/ayzer_backend/.venv/bin/gunicorn --workers=4 --worker-class=uvicorn.workers.UvicornWorker --bind=127.0.0.1:8085 --log-level=info main:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
