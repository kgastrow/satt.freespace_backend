#!/usr/bin/env bash

echo "Stopping Freespace Backend services..."
systemctl stop freespace_worker.service || true
systemctl stop freespace_backend.service || true

echo "Removing Freespace Backend services..."
systemctl disable freespace_worker.service || true
systemctl disable freespace_backend.service || true

echo "Removing Apache sites..."
a2dissite freespace.conf || true
systemctl reload apache2 || true
