{
    "server": {
        "host": "0.0.0.0",
        "port": 8000,
        "debug": false,
        "enable_docs": true,
        "_trusted_client_ip_header": "Header carrying the real client IP, set by the reverse proxy. REQUIRED in this compose stack: nginx runs as a separate container, so without it every request keys to the nginx container address and the per-IP brute-force lockout and rate limiter become one shared bucket for the whole deployment. Only ever name a header the proxy OVERWRITES - deploy/nginx.conf sets X-Real-IP with proxy_set_header, which overwrites. Append-only headers (X-Forwarded-For, Forwarded) are refused at startup because a client can prefix them.",
        "trusted_client_ip_header": "X-Real-IP"
    },
    "database": {
        "host": "pgbouncer",
        "port": 5432,
        "pgbouncer_port": 5432,
        "user": "appuser",
        "password": "password",
        "db": "appdb",
        "echo": false,
        "pooling": {
            "pool_size": 2,
            "max_overflow": 1,
            "pool_timeout": 30,
            "pool_recycle": 1800,
            "pool_pre_ping": true
        }
    },
    "_public_url_frontend": "Origin that serves the SPA bundle. EVERY URL MAILED TO A USER is built from it (password reset, invitation, unsubscribe page) plus the SSO redirect_uri fallback (/oauth/callback) - all of them are client-side routes, not API routes. Behind a single origin, set this and public_url_backend to the same value.",
    "public_url_frontend": "http://localhost:5173",
    "_public_url_backend": "Origin that serves this API under /api/v1. Used for anything a third-party system calls or SIGNS: Twilio webhook signature reconstruction and the status_callback handed to Twilio, the RFC 8058 one-click unsubscribe POST target, and local-file download URLs. A frontend origin here breaks webhook signature verification.",
    "public_url_backend": "http://localhost:8000",
    "jwt": {
        "secret": "your-secret-key-change-in-production",
        "algorithm": "HS256",
        "access_token_expiry": 86400,
        "refresh_token_expiry": 2592000
    },
    "encryption": {
        "key": "",
        "key_previous": ""
    },
    "redis": {
        "url": "redis://redis:6379/0",
        "arq_url": "redis://redis:6379/1"
    },
    "cache": {
        "enabled": true,
        "jwt_ttl": 3600,
        "user_ttl": 300,
        "org_ttl": 300,
        "roles_ttl": 60,
        "_unavailable_cooldown": "Seconds to stop probing Redis after it fails, before re-testing. The cache fails open (a miss, never an exception), so this only paces the retries. Caching resumes on its own once Redis returns - no restart.",
        "unavailable_cooldown": 10
    },
    "email": {
        "server": "smtp.example.com",
        "port": 587,
        "username": "",
        "password": "",
        "use_tls": true,
        "use_ssl": false,
        "sender": "noreply@example.com"
    },
    "freespace": {
        "_mock_mode": "Mock/demonstration mode (BF-84): registers /mock/* routes. Read once at startup. With server.debug false the app refuses to start unless mock_mode_acknowledged is also true. Never on in production.",
        "mock_mode": false,
        "mock_mode_acknowledged": false,
        "_fcm_credentials_path": "Path INSIDE the container to the FCM service-account JSON (BF-68). docker-compose.prod.yml mounts the host directory ${FREESPACE_FCM_DIR:-/etc/freespace/fcm} read-only at /run/freespace-fcm for api and worker. Never copy the file into the image or the repository. Empty disables push delivery.",
        "fcm_credentials_path": "/run/freespace-fcm/service-account.json",
        "fcm_project_id": ""
    },
    "rate_limit": {
        "enabled": true,
        "default": "100/minute",
        "login": "5/minute",
        "otp_verify": "5/minute",
        "otp_send": "3/minute",
        "freespace_availability": "60/minute",
        "freespace_sites": "30/minute",
        "freespace_device_per_id": "10/minute",
        "freespace_device_per_ip": "30/minute",
        "freespace_ingest": "12/minute"
    },
    "logging": {
        "level": "INFO",
        "filename": "app.log"
    },
    "metrics": {
        "enabled": true,
        "endpoint": "/metrics",
        "excluded_paths": "/metrics,/health,/docs,/redoc,/openapi.json",
        "slow_request_threshold": 1.0,
        "slow_query_threshold": 0.1,
        "user_activity_window": 300,
        "instance_id": ""
    }
}
