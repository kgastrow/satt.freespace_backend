# ==============================================================================
# SECURITY WARNING: VITE_ Environment Variables
# ==============================================================================
# All variables prefixed with VITE_ are embedded in the client JavaScript bundle
# and are visible to end users in browser DevTools and network traffic.
#
# NEVER put secrets, API keys, passwords, or credentials in VITE_ variables.
# Sensitive configuration must come from the backend via authenticated API calls.
#
# Safe for VITE_: public URLs, feature flags, app names, org slugs
# NOT safe for VITE_: API keys, secrets, tokens, passwords, private keys
# ==============================================================================

# Organization Configuration
VITE_ORG_SLUG=default-org

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000

# PWA Support (optional)
VITE_ENABLE_PWA=false
VITE_PWA_APP_NAME=FREESPACE

# OpenAPI Type Generation (used by npm run build / generate:types)
# These are NOT prefixed with VITE_ so they stay server-side only
BACKEND_DOCS_URL=http://localhost:8000
API_DOCS_USERNAME=freespace
API_DOCS_PASSWORD=freespace
