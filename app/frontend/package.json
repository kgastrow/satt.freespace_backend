{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npx tsx scripts/validate-env.ts",
    "build": "npm run generate:types && tsc -b && vite build",
    "build:only": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:types": "bash ../../scripts/generate-api-types.sh",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "perf": "lhci autorun --config=lighthouserc.json",
    "perf:report": "lhci open ./lighthouse-results"
  },
