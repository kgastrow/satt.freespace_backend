# (REQUIRED) Anthropic Configuration to run Claude Code in programmatic mode
ANTHROPIC_API_KEY=

# GitHub Configuration (Optional)
# Use this if you want ADW to use a different GitHub account than your default 'gh auth' login
# If not set, ADW will use whatever GitHub account is authenticated with 'gh auth login'
# (Optional)
GITHUB_PAT=
GITHUB_WEBHOOK_SECRET=

# (Optional) Claude Code Path - if 'claude' does not work run 'which claude' and paste that value here
CLAUDE_CODE_PATH=claude

# (Optional) LLM Mode for lightweight prompts (completion messages, agent names)
# Options: "api" (default) - Direct Anthropic API calls, requires ANTHROPIC_API_KEY
#          "cli" - Use Claude Code CLI (claude -p), uses Claude Code's stored credentials
# Note: CLI mode doesn't require ANTHROPIC_API_KEY if you've run 'claude login'
CLAUDE_LLM_MODE=cli

# (Optional) Agent Cloud Sandbox Environment
E2B_API_KEY=

# (Optional) Returns claude code to the root directory after every command
CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=true

# Cross-Codebase Isolation
# Ports and worktree Redis databases come from the machine-wide resource registry (~/.adw/resources.json),
# shared by every codebase on this machine: nothing to configure. See adws/adw_modules/resources.py, and
# `uv run adws/adw_resources.py status`. Optional machine-wide settings (here, or in ~/.adw/config.json):
# ADW_MAX_WORKFLOWS=4          workflows running at once on this machine, all codebases together
# ADW_MAX_FULL_SUITES=2        full test-suite runs at once on this machine
# ADW_BACKEND_PORTS=9100-9199, ADW_FRONTEND_PORTS=9200-9299, ADW_REDIS_DBS=2-14,30-164
# ADW_RESOURCES=static         the old static per-codebase slices below instead of the registry
# ADW_ORCHESTRATED=0           route issues to the classic SDLC workflows instead of Orchestrated SDLC
#
# The codebase index still names the isolated PostgreSQL databases and the e2e test ports / Redis database,
# so each codebase needs a unique index.
# When the Command Center agent is enabled, these values are AUTOMATICALLY ASSIGNED
# by the server on connection and written here. Do not edit manually in that case.
# When running without a command center, set these manually:
# ADW_CODEBASE_INDEX: Which slot this codebase uses (0-based). Default: 0
# ADW_MAX_CODEBASES: Total number of codebases running simultaneously. Default: 1
# With ADW_RESOURCES=static, each codebase gets its own slice of ports (9100-9114) and Redis DBs (2-14).
ADW_CODEBASE_INDEX=0
ADW_MAX_CODEBASES=1

# (Optional) Command Center Agent
# Connect this codebase to a centralized Ayzer Command Center for monitoring,
# triggering ADW workflows, and deployment management.
# If COMMAND_CENTER_URL is not set or empty, the command center agent does not start.
# Uncomment and set your API key to enable:
# COMMAND_CENTER_URL=wss://agent-bridge.ayzer.ai/ws/agent
COMMAND_CENTER_URL=
COMMAND_CENTER_API_KEY=
CODEBASE_NAME=ayzer-webapp-template
MACHINE_NAME=
# (Optional) Port for local health check endpoint (disabled if empty)
CC_AGENT_HEALTH_PORT=

# (Optional) If you use cloudflare's tunnel to expose `adws/trigger_webhook.py` to github (public internet)
CLOUDFLARED_TUNNEL_TOKEN=

# (Optional) Cloudflare R2 Configuration for uploading smoke test and review screenshots
# If configured, screenshots will be uploaded to R2 and displayed as images in GitHub comments
# Without this, comments will show "X captured (local)" instead of embedded images
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=
